# Firebase (JS SDK) — คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Firebase Console
# Project settings → General → Your apps → SDK setup and configuration (Config)
# ค่าเหล่านี้ไม่ใช่ความลับ (ฝังในแอปได้) ความปลอดภัยจริงอยู่ที่ Firestore Security Rules
# ต้องขึ้นต้นด้วย EXPO_PUBLIC_ เพื่อให้ Expo/Metro inject เข้าโค้ด
# แก้ค่าแล้วรีสตาร์ทด้วย: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
